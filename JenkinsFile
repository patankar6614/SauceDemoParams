pipeline
	{
		agent any

		parameters
		{
			choice(
					name : 'ENVIRONMENT_NAME',
					choices : ['qa', 'uat', 'staging'],
					description : 'Select Environment Name'
				)

			choice(
					name : 'BROWSER_NAME',
					choices : ['chromium',  'webkit'],
					description : 'Select Browser Name'
				)
			
			choice(
					name : 'SUITE_NAME',
					choices : ['Regression', 'Smoke'],
					description : 'Select Suite Type'
				)
		
			String(
					name : 'BRANCH_NAME',
					defaultValue : 'master',
					description : 'Enter Branch Name'
				)
			String(
					name : 'WORKER_NUMBER',
					defaultValue : 1,
					description : 'Enter Workers Numbr'
				)
		}
		
		stages
		{
			stage("Clone GitHub Repository")
			{
				steps
				{
					git  url : 'https://github.com/patankar6614/SauceDemoParams.git', branch : %BRANCH_NAME%
				}
			}
			stage("Install package.json dependencies ")
			{
				steps
				{
					bat npm ci
				}
			}

			stage("install Playwright")
			{
				steps
				{
					bat "npm install playwright"
				}
			}

			stage("Execute Test cases")
			{
				steps
				{
					bat "if exist allure-results rmdir /s /q allure-results"

					bat set TEST_ENV = %ENVIRONMENT_NAME%
					
					bat npx playwright test --project=%BROWSER_NAME% --grep %SUITE_NAME% --workers = %WORKER_NUMBER%

				}
			}
		}

		post{
			always
				{
					script 
						{
							allure([
									includeProperties : false,
									reportBuildPolicy : 'ALWAYS',
									result : [[path : 'allure-results']]
								])
						}
				}
	
			}

	}	
	

